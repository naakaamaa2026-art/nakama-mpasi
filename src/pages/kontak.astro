---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Kontak & Konsultasi', url: '/kontak' }
];

const faqs = [
  {
    q: 'Bagaimana cara pemesanan MPASI Mamachy?',
    a: 'Pemesanan sangat mudah Ma! Klik tombol "Pesan via WhatsApp", sertakan alamat pengiriman dan varian yang diinginkan. Tim kami akan segera merespons.'
  },
  {
    q: 'Apakah MPASI Mamachy menggunakan pengawet?',
    a: 'Sama sekali tidak! Semua varian MPASI Mamachy 100% menggunakan bahan alami tanpa pengawet sintetis, garam berlebih, atau MSG.'
  },
  {
    q: 'Bagaimana cara penyimpanan MPASI Mamachy frozen?',
    a: 'Simpan di freezer pada suhu -18°C untuk daya tahan hingga 1 bulan. Sebelum disajikan, cukup kukus 5-10 menit.'
  }
];

const metaDescription = "Hubungi tim spesialis Makanan Bayi & MPASI Mamachy. Konsultasi gratis jadwal MPASI dan nutrisi tumbuh kembang anak untuk mama muda.";
---

<Layout
  title="Kontak & Konsultasi MPASI | Makanan Bayi Mamachy"
  description={metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-pink-50/60 via-white to-white dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="text-center my-10 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-600 dark:text-pink-400 bg-pink-100 dark:bg-brand-950/80 px-4 py-1.5 rounded-full inline-block">
          Konsultasi & Layanan Mama Muda
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Ada Pertanyaan Seputar <span class="pink-gradient-text">MPASI Mamachy</span>?
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-300 max-w-xl mx-auto">
          Tim nutrisi kami selalu siap mendengar dan <strong class="text-brand-600 dark:text-pink-400">menemani tumbuh kembang anak</strong> mama dengan sepenuh hati.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 my-12">
        
        <!-- Info & WhatsApp Contact Box -->
        <div class="p-8 rounded-3xl bg-pink-50/70 dark:bg-slate-800 border border-pink-100 dark:border-slate-700 space-y-6">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Hubungi Kami Direct</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Dapatkan rekomendasi varian tekstur MPASI yang tepat berdasarkan usia dan kondisi tumbuh kembang si kecil.
          </p>

          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500 text-white flex items-center justify-center text-xl shadow-md">
                📱
              </div>
              <div>
                <p class="text-xs text-gray-500 font-semibold">WhatsApp Layanan Mama</p>
                <p class="text-lg font-bold text-gray-900 dark:text-white">+62 812-3456-7890</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500 text-white flex items-center justify-center text-xl shadow-md">
                ✉️
              </div>
              <div>
                <p class="text-xs text-gray-500 font-semibold">Email Edukasi MPASI</p>
                <p class="text-lg font-bold text-gray-900 dark:text-white">halo@makananbayi.com</p>
              </div>
            </div>
          </div>

          <a
            href="https://wa.me/6281234567890?text=Halo%20Mamachy,%20saya%20mau%20konsultasi%20MPASI"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center py-4 rounded-full text-sm font-extrabold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-pink-200 dark:shadow-none transition-all"
          >
            Chat WhatsApp Sekarang
          </a>
        </div>

        <!-- Form Kirim Pesan -->
        <div class="p-8 rounded-3xl bg-white dark:bg-slate-800 border border-pink-100 dark:border-slate-700 shadow-soft space-y-4">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Tinggalkan Pesan</h3>
          
          <div>
            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">Nama Mama</label>
            <input type="text" placeholder="Contoh: Mama Sinta" class="w-full px-4 py-3 rounded-xl border border-pink-200 dark:border-slate-700 bg-pink-50/30 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">Usia Si Kecil</label>
            <input type="text" placeholder="Contoh: 6 Bulan / 9 Bulan" class="w-full px-4 py-3 rounded-xl border border-pink-200 dark:border-slate-700 bg-pink-50/30 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">Pesan / Pertanyaan MPASI</label>
            <textarea rows="4" placeholder="Tuliskan pertanyaan seputar MPASI atau pesanan..." class="w-full px-4 py-3 rounded-xl border border-pink-200 dark:border-slate-700 bg-pink-50/30 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
          </div>

          <button type="button" class="w-full py-3.5 rounded-full font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-md transition-all">
            Kirim Pertanyaan
          </button>
        </div>

      </div>

      <!-- FAQ Section -->
      <div class="my-16 space-y-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white text-center">
          Pertanyaan Sering Diajukan (FAQ)
        </h2>
        <div class="grid grid-cols-1 gap-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-pink-100 dark:border-slate-700 space-y-2">
              <h4 class="text-base font-bold text-gray-900 dark:text-white">{faq.q}</h4>
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
