---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Kontak & Konsultasi', url: '/kontak' }
];

const faqs = [
  {
    q: 'Bagaimana cara pemesanan Nakama MPASI?',
    a: 'Pemesanan sangat mudah Ma! Klik tombol "Pesan via WhatsApp", sertakan alamat pengiriman dan varian yang diinginkan. Tim kami akan segera merespons.'
  },
  {
    q: 'Apakah Nakama MPASI menggunakan pengawet?',
    a: 'Sama sekali tidak! Semua varian Nakama MPASI 100% menggunakan bahan alami tanpa pengawet sintetis, garam berlebih, atau MSG.'
  },
  {
    q: 'Bagaimana cara penyimpanan Nakama MPASI frozen?',
    a: 'Simpan di freezer pada suhu -18°C untuk daya tahan hingga 1 bulan. Sebelum disajikan, cukup kukus 5-10 menit.'
  }
];

const metaDescription = "Hubungi tim spesialis Makanan Bayi & Nakama MPASI. Konsultasi gratis jadwal MPASI dan nutrisi tumbuh kembang anak untuk mama muda.";
---

<Layout
  title="Kontak & Konsultasi MPASI | Makanan Bayi Nakama MPASI"
  description={metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-[#FAF8EE] via-[#F5F3E0] to-[#FAF8EE] min-h-screen transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="text-center my-10 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#B7410E] bg-[#FAF0E6] px-4 py-1.5 rounded-full inline-block border border-[#B7410E]/30 shadow-sm">
          Konsultasi & Layanan Mama Muda
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#2D241E] tracking-tight">
          Ada Pertanyaan Seputar <span class="pink-gradient-text">Nakama MPASI</span>?
        </h1>
        <p class="text-base text-[#4E443C] max-w-xl mx-auto">
          Tim nutrisi kami selalu siap mendengar dan <strong class="text-[#B7410E] font-bold">menemani tumbuh kembang anak</strong> mama dengan sepenuh hati.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 my-12">
        
        <!-- Info & WhatsApp Contact Box -->
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] space-y-6 shadow-sm">
          <h3 class="text-2xl font-bold text-[#2D241E]">Hubungi Kami Direct</h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Dapatkan rekomendasi varian tekstur MPASI yang tepat berdasarkan usia dan kondisi tumbuh kembang si kecil.
          </p>

          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#B7410E] text-white flex items-center justify-center text-xl shadow-md shadow-[#B7410E]/20">
                📱
              </div>
              <div>
                <p class="text-xs text-[#5A5046] font-semibold">WhatsApp Layanan Mama</p>
                <p class="text-lg font-extrabold text-[#2D241E]">+62 812-3456-7890</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#B7410E] text-white flex items-center justify-center text-xl shadow-md shadow-[#B7410E]/20">
                ✉️
              </div>
              <div>
                <p class="text-xs text-[#5A5046] font-semibold">Email Edukasi MPASI</p>
                <p class="text-lg font-extrabold text-[#2D241E]">halo@makananbayi.com</p>
              </div>
            </div>
          </div>

          <a
            href="https://wa.me/6281234567890?text=Halo%20Nakama MPASI,%20saya%20mau%20konsultasi%20MPASI"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center py-4 rounded-full text-sm font-extrabold text-white bg-[#B7410E] hover:bg-[#96340B] shadow-lg shadow-[#B7410E]/25 transition-all"
          >
            Chat WhatsApp Sekarang
          </a>
        </div>

        <!-- Form Kirim Pesan -->
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] shadow-sm space-y-4">
          <h3 class="text-2xl font-bold text-[#2D241E] mb-2">Tinggalkan Pesan</h3>
          
          <div>
            <label class="block text-xs font-bold text-[#2D241E] mb-1">Nama Mama</label>
            <input type="text" placeholder="Contoh: Mama Sinta" class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#F5F3E0] text-sm text-[#2D241E] focus:outline-none focus:ring-2 focus:ring-[#B7410E]" />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#2D241E] mb-1">Usia Si Kecil</label>
            <input type="text" placeholder="Contoh: 6 Bulan / 9 Bulan" class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#F5F3E0] text-sm text-[#2D241E] focus:outline-none focus:ring-2 focus:ring-[#B7410E]" />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#2D241E] mb-1">Pesan / Pertanyaan MPASI</label>
            <textarea rows="4" placeholder="Tuliskan pertanyaan seputar MPASI atau pesanan..." class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#F5F3E0] text-sm text-[#2D241E] focus:outline-none focus:ring-2 focus:ring-[#B7410E]"></textarea>
          </div>

          <button type="button" class="w-full py-3.5 rounded-full font-extrabold text-white bg-[#B7410E] hover:bg-[#96340B] shadow-md shadow-[#B7410E]/20 transition-all">
            Kirim Pertanyaan
          </button>
        </div>

      </div>

      <!-- FAQ Section -->
      <div class="my-16 space-y-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#2D241E] text-center">
          Pertanyaan Sering Diajukan (FAQ)
        </h2>
        <div class="grid grid-cols-1 gap-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-[#FAF8EE] border border-[#DFD8B4] space-y-2">
              <h4 class="text-base font-bold text-[#2D241E]">{faq.q}</h4>
              <p class="text-sm text-[#4E443C] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
