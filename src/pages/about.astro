---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tentang Kami', url: '/about' }
];

const metaDescription = "Mengenal Makanan Bayi & Nakama MPASI. Misi kami membantu mama muda menyediakan nutrisi terbaik 100% alami untuk menemani tumbuh kembang anak indonesia.";
---

<Layout
  title="Tentang Makanan Bayi & Nakama MPASI | Edukasi Nutrisi MPASI"
  description={metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-[#FAF8EE] via-[#F5F3E0] to-[#FAF8EE] min-h-screen transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="text-center my-10 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#B7410E] bg-[#FAF0E6] px-4 py-1.5 rounded-full inline-block border border-[#B7410E]/30 shadow-sm">
          Kisah & Komitmen Kami
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#2D241E] tracking-tight">
          Menemani Setiap Langkah <span class="pink-gradient-text">Tumbuh Kembang Anak</span>
        </h1>
        <p class="text-base text-[#4E443C] max-w-2xl mx-auto leading-relaxed">
          Makanan Bayi didirikan dengan satu misi mulia: Membantu setiap mama muda menyajikan makanan pendamping bayi (MPASI) yang lezat, bernutrisi tinggi, bebas pengawet, serta mudah disiapkan.
        </p>
      </div>

      <!-- Hero Story Banner Image -->
      <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-[#FAF8EE] mb-16 aspect-video">
        <img
          src="https://images.unsplash.com/photo-1543362906-acfc16c67564?auto=format&fit=crop&w=1200&q=80"
          alt="Proses Pembuatan Nakama MPASI Alami dan Higienis"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Values Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-16">
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] space-y-3 shadow-sm transition-all">
          <h3 class="text-xl font-bold text-[#2D241E] flex items-center gap-2">
            <span class="text-[#B7410E]">🎯</span> Misi Nutrisi MPASI
          </h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Menyediakan bahan MPASI segar kaya protein hewani dan zat besi alami untuk menekan angka kejadian stunting pada 1000 HPK anak Indonesia.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] space-y-3 shadow-sm transition-all">
          <h3 class="text-xl font-bold text-[#2D241E] flex items-center gap-2">
            <span class="text-[#B7410E]">💡</span> Edukasi Terpercaya
          </h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Memberikan literasi praktis kepada mama muda seputar jadwal pemberian MPASI, penanganan GTM, dan variasi tekstur makanan bertahap.
          </p>
        </div>
      </div>

      <!-- Callout CTA -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#96340B] via-[#B7410E] to-[#96340B] text-white text-center space-y-4 shadow-xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#FAF8EE]">Mari Bersama Menjaga Tumbuh Kembang Si Kecil</h2>
        <p class="text-[#FAF8EE]/90 max-w-xl mx-auto text-sm">Dapatkan ragam varian Nakama MPASI homemade sehat sekarang juga.</p>
        <a href="/produk" class="inline-block px-8 py-3.5 rounded-full font-extrabold text-[#B7410E] bg-[#FAF8EE] hover:bg-white transition-all shadow-md">
          Lihat Katalog Nakama MPASI
        </a>
      </div>

    </div>
  </section>
</Layout>
