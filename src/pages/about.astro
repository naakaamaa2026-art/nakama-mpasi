---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tentang Kami', url: '/about' }
];

const metaDescription = "Mengenal Makanan Bayi & MPASI Mamachy. Misi kami membantu mama muda menyediakan nutrisi terbaik 100% alami untuk menemani tumbuh kembang anak indonesia.";
---

<Layout
  title="Tentang Makanan Bayi & MPASI Mamachy | Edukasi Nutrisi MPASI"
  description={metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-pink-50/60 via-white to-white dark:from-slate-900 dark:via-slate-900 dark:to-slate-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="text-center my-10 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-600 dark:text-pink-400 bg-pink-100 dark:bg-brand-950/80 px-4 py-1.5 rounded-full inline-block">
          Kisah & Komitmen Kami
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Menemani Setiap Langkah <span class="pink-gradient-text">Tumbuh Kembang Anak</span>
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Makanan Bayi didirikan dengan satu misi mulia: Membantu setiap mama muda menyajikan makanan pendamping bayi (MPASI) yang lezat, bernutrisi tinggi, bebas pengawet, serta mudah disiapkan.
        </p>
      </div>

      <!-- Hero Story Banner Image -->
      <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 mb-16 aspect-video">
        <img
          src="https://images.unsplash.com/photo-1543362906-acfc16c67564?auto=format&fit=crop&w=1200&q=80"
          alt="Proses Pembuatan MPASI Mamachy Alami dan Higienis"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Values Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-16">
        <div class="p-8 rounded-3xl bg-pink-50/60 dark:bg-slate-800 border border-pink-100 dark:border-slate-700 space-y-3">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <span>🎯</span> Misi Nutrisi MPASI
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Menyediakan bahan MPASI segar kaya protein hewani dan zat besi alami untuk menekan angka kejadian stunting pada 1000 HPK anak Indonesia.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-pink-50/60 dark:bg-slate-800 border border-pink-100 dark:border-slate-700 space-y-3">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <span>💡</span> Edukasi Terpercaya
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            Memberikan literasi praktis kepada mama muda seputar jadwal pemberian MPASI, penanganan GTM, dan variasi tekstur makanan bertahap.
          </p>
        </div>
      </div>

      <!-- Callout CTA -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-brand-500 to-brand-600 text-white text-center space-y-4 shadow-xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold">Mari Bersama Menjaga Tumbuh Kembang Si Kecil</h2>
        <p class="text-pink-100 max-w-xl mx-auto text-sm">Dapatkan ragam varian MPASI Mamachy homemade sehat sekarang juga.</p>
        <a href="/produk" class="inline-block px-8 py-3.5 rounded-full font-bold text-brand-700 bg-white hover:bg-pink-50 transition-all shadow-md">
          Lihat Katalog MPASI Mamachy
        </a>
      </div>

    </div>
  </section>
</Layout>
