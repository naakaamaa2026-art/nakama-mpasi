---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Katalog Produk MPASI Mamachy', url: '/produk' }
];

const products = [
  {
    id: 1,
    name: 'MPASI Mamachy Varian Hati Ayam & Bayam',
    stage: 'Usia 6 Bulan + (Puree Halus)',
    price: 'Rp 28.000 / porsi',
    image: 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=800&q=80',
    description: 'Tinggi kandungan zat besi alami dari hati ayam kampung & asam folat bayam Jepang. Bebas amis & disukai si kecil.',
    tags: ['Zat Besi Tinggi', 'Bebas Pengawet', 'Puree Halus']
  },
  {
    id: 2,
    name: 'MPASI Mamachy Daging Sapi & Butter',
    stage: 'Usia 8 Bulan + (Chop/Cincang Halus)',
    price: 'Rp 32.000 / porsi',
    image: 'https://images.unsplash.com/photo-1543362906-acfc16c67564?auto=format&fit=crop&w=800&q=80',
    description: 'Daging sapi tenderloin kaya protein dengan aroma unsalted butter alami yang menggugah selera saat GTM.',
    tags: ['Protein Tinggi', 'Lemak Tambahan', 'Cincang Halus']
  },
  {
    id: 3,
    name: 'MPASI Mamachy Salmon & Ubi Manis',
    stage: 'Usia 12 Bulan + (Nasi Tim/Lembek)',
    price: 'Rp 35.000 / porsi',
    image: 'https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=800&q=80',
    description: 'Kaya Omega-3 & DHA untuk perkembangan sel otak bayi. Dilengkapi rasa manis alami ubi madu organik.',
    tags: ['Omega-3 DHA', 'Nutrisi Otak', 'Tekstur Tim']
  }
];

const metaDescription = "Katalog resmi MPASI Mamachy. Makanan bayi organik kaya zat besi dan protein hewani tanpa pengawet. Tersedia untuk usia 6-24 bulan.";
---

<Layout
  title="Katalog Produk MPASI Mamachy | Makanan Bayi Organik Sehat"
  description={metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-pink-50/60 via-white to-pink-50/30 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="text-center max-w-3xl mx-auto my-10 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-600 dark:text-pink-400 bg-pink-100 dark:bg-brand-950/80 px-4 py-1.5 rounded-full inline-block">
          Produk Unggulan Mamachy
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Varian Sehat <span class="pink-gradient-text">MPASI Mamachy</span>
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-300">
          Setiap menu diracik berdasarkan standar kecukupan gizi angka gizi harian (AKG) anak untuk <strong class="text-brand-600 dark:text-pink-400">menemani tumbuh kembang anak</strong> secara optimal.
        </p>
      </div>

      <!-- Product Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 my-12">
        {products.map((item) => (
          <div class="bg-white dark:bg-slate-800 rounded-3xl overflow-hidden border border-pink-100 dark:border-slate-700 shadow-soft hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="relative aspect-video">
                <img src={item.image} alt={`${item.name} - Makanan bayi`} loading="lazy" class="w-full h-full object-cover" />
                <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-extrabold bg-white/90 text-brand-600 backdrop-blur-md shadow-sm">
                  {item.stage}
                </span>
              </div>

              <div class="p-6 space-y-3">
                <div class="flex flex-wrap gap-1.5">
                  {item.tags.map((t) => (
                    <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold text-brand-700 dark:text-pink-300 bg-pink-100 dark:bg-slate-700">
                      {t}
                    </span>
                  ))}
                </div>

                <h3 class="text-xl font-bold text-gray-900 dark:text-white">{item.name}</h3>
                <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">{item.description}</p>
              </div>
            </div>

            <div class="p-6 pt-0 space-y-4">
              <div class="text-lg font-extrabold text-brand-600 dark:text-pink-400">{item.price}</div>
              <a
                href={`https://wa.me/6281234567890?text=Halo%20Mamachy,%20saya%20mau%20pesan%20${encodeURIComponent(item.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center py-3 rounded-full text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 shadow-md transition-all"
              >
                Pesan via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
