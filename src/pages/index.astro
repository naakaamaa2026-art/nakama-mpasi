---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPublishedPosts } from '../lib/notion';

// Fetch 3 artikel terbaru dari Notion API
const allPosts = await getPublishedPosts();
const latestPosts = allPosts.slice(0, 3);

const metaDescription = "Website edukasi makanan pendamping bayi (MPASI) terlengkap untuk mama muda. Dapatkan varian produk Nakama MPASI organik kaya zat besi untuk tumbuh kembang anak.";
---

<Layout
  title="Makanan Bayi & Nakama MPASI - Edukasi Nutrisi MPASI Mama Muda"
  description={metaDescription}
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Fitur Unggulan / Why Choose Us (3 Poin) -->
  <section class="py-16 sm:py-24 bg-[#F5F3E0] border-b border-[#DFD8B4] transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#B7410E] bg-[#FAF0E6] px-4 py-1.5 rounded-full inline-block border border-[#B7410E]/30 shadow-sm">
          Mengapa Pilih Nakama MPASI?
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#2D241E] tracking-tight">
          3 Keunggulan Utama <span class="pink-gradient-text">Makanan Bayi Nakama MPASI</span>
        </h2>
        <p class="text-base text-[#4E443C]">
          Dirancang khusus untuk membantu mama muda menyajikan makanan pendamping bayi terbaik dengan nutrisi utuh tanpa repot.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Poin 1 -->
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] hover:shadow-xl transition-all duration-300 group shadow-sm">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#B7410E] to-[#D4541B] text-white flex items-center justify-center text-2xl font-bold mb-6 shadow-md shadow-[#B7410E]/20 group-hover:scale-110 transition-transform">
            🥩
          </div>
          <h3 class="text-xl font-bold text-[#2D241E] mb-3 group-hover:text-[#B7410E] transition-colors">
            1. Kaya Protein Hewani & Zat Besi Dini
          </h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Diformulasikan sesuai standar WHO dengan kandungan hati ayam, daging sapi, dan salmon segar untuk mencegah anemia dan stunting pada bayi.
          </p>
        </div>

        <!-- Poin 2 -->
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] hover:shadow-xl transition-all duration-300 group shadow-sm">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#B7410E] to-[#D4541B] text-white flex items-center justify-center text-2xl font-bold mb-6 shadow-md shadow-[#B7410E]/20 group-hover:scale-110 transition-transform">
            🌿
          </div>
          <h3 class="text-xl font-bold text-[#2D241E] mb-3 group-hover:text-[#B7410E] transition-colors">
            2. 100% Alami & Tanpa Pengawet Sintetis
          </h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Bebas garam tambahan, gula berlebih, dan MSG. Diproses secara higienis menggunakan teknologi pembekuan cepat yang menjaga kualitas gizi alami.
          </p>
        </div>

        <!-- Poin 3 -->
        <div class="p-8 rounded-3xl bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] hover:shadow-xl transition-all duration-300 group shadow-sm">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#B7410E] to-[#D4541B] text-white flex items-center justify-center text-2xl font-bold mb-6 shadow-md shadow-[#B7410E]/20 group-hover:scale-110 transition-transform">
            ⏰
          </div>
          <h3 class="text-xl font-bold text-[#2D241E] mb-3 group-hover:text-[#B7410E] transition-colors">
            3. Praktis Siap Saji dalam 5 Menit
          </h3>
          <p class="text-sm text-[#4E443C] leading-relaxed">
            Sangat efisien untuk mama muda berkarir maupun produktif di rumah. Tinggal kukus atau hangatkan, MPASI lezat siap disajikan kapan saja.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. Section Blog Terbaru (3 Post dari Notion) -->
  <section class="py-16 sm:py-24 bg-gradient-to-b from-[#FAF8EE] via-[#F5F3E0] to-[#FAF8EE] border-b border-[#DFD8B4] transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div class="space-y-3">
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#B7410E]">
            Edukasi Makanan Pendamping Bayi
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#2D241E] tracking-tight">
            Artikel MPASI Terbaru dari <span class="pink-gradient-text">Nakama MPASI Edukasi</span>
          </h2>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center text-sm font-extrabold text-[#B7410E] hover:text-[#96340B] gap-2 group"
        >
          <span>Lihat Semua Artikel</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Blog Grid (3 Terbaru) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. CTA Utama Section: "menemani tumbuh kembang anak" -->
  <section class="py-20 bg-gradient-to-r from-[#96340B] via-[#B7410E] to-[#96340B] text-white relative overflow-hidden shadow-2xl">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      <span class="px-4 py-1.5 rounded-full text-xs font-extrabold bg-white/20 text-[#FAF8EE] backdrop-blur-md inline-block uppercase tracking-wider border border-white/20">
        Komitmen Makanan Bayi & Nakama MPASI
      </span>

      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
        Siap <span class="underline decoration-[#F5F3E0] underline-offset-8">Menemani Tumbuh Kembang Anak</span> Lebih Sehat & Ceria?
      </h2>

      <p class="text-lg text-[#FAF8EE]/90 max-w-2xl mx-auto leading-relaxed">
        Berikan yang terbaik untuk 1000 Hari Pertama Kehidupan buah hati mama. Pesan varian Nakama MPASI sekarang dan dapatkan gratis panduan resep MPASI 6-24 bulan!
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/produk"
          class="w-full sm:w-auto px-9 py-4 rounded-full text-base font-extrabold text-[#B7410E] bg-[#FAF8EE] hover:bg-white shadow-xl hover:scale-105 transition-all"
        >
          Beli Paket Nakama MPASI Sekarang
        </a>
        <a
          href="/kontak"
          class="w-full sm:w-auto px-9 py-4 rounded-full text-base font-bold text-white border-2 border-white/50 hover:bg-white/15 backdrop-blur-md transition-all"
        >
          Konsultasi Gratis via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
