---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import type { Props as SEOProps } from '../components/SEO.astro';
import '../styles/global.css';

export interface Props extends SEOProps {}

const seoProps = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <SEO {...seoProps} />
    <meta name="theme-color" content="#F5F3E0" />
    <script is:inline>
      // Enforce clean Beige (#F5F3E0) & Merah Bata (#B7410E) brand identity
      document.documentElement.classList.remove('dark');
      try {
        localStorage.removeItem('color-theme');
        localStorage.clear();
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-[#F5F3E0] text-[#2D241E] selection:bg-[#B7410E] selection:text-white">
    <Navbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppWidget />
  </body>
</html>
