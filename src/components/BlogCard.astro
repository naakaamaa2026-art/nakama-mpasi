---
import type { BlogPost } from '../lib/notion';

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Format tanggal ke Bahasa Indonesia (contoh: 25 September 2026)
const formattedDate = new Date(post.date).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group bg-[#FAF8EE] rounded-3xl overflow-hidden border border-[#DFD8B4] hover:border-[#B7410E] shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col h-full">
  
  <!-- Image Container -->
  <a href={`/blog/${post.slug}`} class="relative overflow-hidden aspect-video block bg-[#ECE6C8]">
    <img
      src={post.coverImage}
      alt={`${post.title} - Makanan bayi`}
      loading="lazy"
      width="600"
      height="338"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    
    <!-- Primary Tag Badge -->
    <div class="absolute top-4 left-4 flex flex-wrap gap-1.5">
      {post.tags.slice(0, 2).map((tag) => (
        <span class="px-3 py-1 rounded-full text-xs font-bold text-white bg-[#B7410E] backdrop-blur-md shadow-sm">
          {tag}
        </span>
      ))}
    </div>
  </a>

  <!-- Content Body -->
  <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
    <div class="space-y-3">
      
      <!-- Meta info: Date & Reading Time -->
      <div class="flex items-center text-xs font-semibold text-[#5A5046] gap-3">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-[#B7410E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          {formattedDate}
        </span>
        <span>•</span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-[#B7410E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {post.readingTime}
        </span>
      </div>

      <!-- Title (Header / CTA) -->
      <h3 class="text-xl font-bold text-[#2D241E] group-hover:text-[#B7410E] transition-colors line-clamp-2 leading-snug">
        <a href={`/blog/${post.slug}`}>
          {post.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-[#4E443C] line-clamp-3 leading-relaxed">
        {post.excerpt}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="pt-4 border-t border-[#DFD8B4] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-[#FAF0E6] text-[#B7410E] border border-[#B7410E]/20 font-bold text-xs flex items-center justify-center">
          M
        </div>
        <span class="text-xs font-semibold text-[#4E443C]">{post.author}</span>
      </div>

      <a href={`/blog/${post.slug}`} class="text-xs font-bold text-[#B7410E] group-hover:translate-x-1 transition-transform flex items-center gap-1">
        <span>Baca Artikel</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

  </div>
</article>
