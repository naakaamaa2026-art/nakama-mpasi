---
---

<section class="relative overflow-hidden bg-gradient-to-b from-[#FAF8EE] via-[#F5F3E0] to-[#FAF8EE] py-16 lg:py-24 border-b border-[#DFD8B4]">
  <!-- Background Decorative Glowing Circles -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#B7410E]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 bg-[#DFD8B4]/40 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copywriting for Mama Muda -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FAF0E6] border border-[#B7410E]/30 shadow-sm">
          <span class="flex h-2.5 w-2.5 rounded-full bg-[#B7410E] animate-pulse"></span>
          <span class="text-xs font-extrabold text-[#B7410E] tracking-wide uppercase">
            Sahabat Utama Mama Muda Indonesia
          </span>
        </div>

        <!-- H1 Headline (Cuma SATU H1 di Homepage untuk SEO) -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#2D241E] tracking-tight leading-tight">
          Solusi <span class="pink-gradient-text">Makanan Bayi</span> & Nakama MPASI Bergizi Tinggi
        </h1>

        <!-- Subheading Meta-rich -->
        <p class="text-base sm:text-lg text-[#4E443C] max-w-2xl leading-relaxed mx-auto lg:mx-0">
          Setiap suapan Nakama MPASI diproses dari bahan segar 100% alami, tinggi zat besi, tanpa pengawet, serta diformulasikan khusus untuk <strong class="text-[#B7410E] font-bold">menemani tumbuh kembang anak</strong> dengan ceria & bebas stunting.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
          <a
            href="/produk"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full text-sm font-extrabold text-white bg-[#B7410E] hover:bg-[#96340B] shadow-lg shadow-[#B7410E]/30 hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2"
          >
            <span>Pesan Nakama MPASI</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/kalkulator"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full text-sm font-extrabold text-[#B7410E] bg-[#FAF8EE] border-2 border-[#B7410E] hover:bg-[#B7410E] hover:text-white shadow-sm transition-all flex items-center justify-center gap-2"
          >
            <span>🧮 Hitung Kalkulator MPASI</span>
          </a>
          <a
            href="/blog"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full text-sm font-bold text-[#2D241E] bg-[#FAF8EE] border border-[#DFD8B4] hover:border-[#B7410E] hover:text-[#B7410E] transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-[#B7410E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <span>Baca Edukasi</span>
          </a>
        </div>

        <!-- Social Proof Stats -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-[#DFD8B4] max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-2xl font-extrabold text-[#B7410E]">10.000+</div>
            <div class="text-xs font-semibold text-[#5A5046]">Mama Muda Puas</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#B7410E]">100%</div>
            <div class="text-xs font-semibold text-[#5A5046]">Alami & Tanpa Pengawet</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#B7410E]">4.9/5★</div>
            <div class="text-xs font-semibold text-[#5A5046]">Rating Nutrisi Dokter</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Hero Card & Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Image Wrapper with Glow Shadow -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-[#B7410E]/20 border-4 border-[#FAF8EE] transform rotate-1 hover:rotate-0 transition-transform duration-300">
            <img
              src="/images/hero-bayi.png"
              alt="Bayi Sehat dengan Nakama MPASI Bergizi"
              loading="eager"
              width="800"
              height="600"
              class="w-full h-80 sm:h-96 lg:h-[420px] object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-[#F5F3E0]/95 backdrop-blur-md border border-[#DFD8B4]">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[#B7410E] text-white flex items-center justify-center font-bold text-lg shadow-sm">
                  🍲
                </div>
                <div>
                  <h4 class="text-sm font-bold text-[#2D241E]">Nakama MPASI Varian Hati Ayam</h4>
                  <p class="text-xs text-[#B7410E] font-semibold">Tinggi Zat Asam Folat & Zat Besi Dini</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Badge Top Left -->
          <div class="absolute -top-4 -left-4 bg-[#FAF8EE] p-3.5 rounded-2xl shadow-xl border border-[#DFD8B4] flex items-center gap-3 animate-bounce">
            <span class="text-2xl">👶</span>
            <div>
              <p class="text-xs font-bold text-[#2D241E]">Usia 6 - 24 Bulan</p>
              <p class="text-[10px] text-[#B7410E] font-semibold">Tekstur Disesuaikan</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
