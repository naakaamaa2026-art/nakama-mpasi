      <!-- Navigasi Utama -->
      <div>
        <h4 class="text-base font-bold text-gray-900 dark:text-white mb-4">Navigasi Utama</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Beranda</a></li>
          <li><a href="/kalkulator" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-bold text-brand-600 dark:text-pink-400">🧮 Kalkulator MPASI</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Edukasi MPASI Blog</a></li>
          <li><a href="/produk" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Produk MPASI Mamachy</a></li>
          <li><a href="/about" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Tentang Kami</a></li>
          <li><a href="/kontak" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Kontak & Layanan</a></li>
        </ul>
      </div>

      <!-- Topik Edukasi MPASI -->
      <div>
        <h4 class="text-base font-bold text-gray-900 dark:text-white mb-4">Topik Edukasi Popular</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Panduan MPASI 6 Bulan</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Resep Kaya Zat Besi</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Mengatasi GTM (Gerakan Tutup Mulut)</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Lemak Tambahan & Kalori</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Pencegahan Stunting Dini</a></li>
        </ul>
      </div>

      <!-- Jam Layanan & CTA -->
      <div class="space-y-4">
        <h4 class="text-base font-bold text-gray-900 dark:text-white mb-2">Komitmen Kami</h4>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-pink-200 dark:border-slate-700 shadow-sm">
          <span class="text-xs font-bold text-brand-600 dark:text-pink-400 uppercase tracking-wider block mb-1">CTA UTAMA</span>
          <p class="text-sm font-extrabold text-gray-900 dark:text-white">
            "Menemani Tumbuh Kembang Anak dengan Kasih & Nutrisi Terbaik"
          </p>
          <a href="/produk" class="inline-block mt-3 text-xs font-bold text-brand-600 dark:text-pink-300 hover:underline">
            Lihat Katalog Varian MPASI &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 dark:text-gray-400 gap-4">
      <p>&copy; {currentYear} Makanan Bayi & MPASI Mamachy. Hak Cipta Dilindungi Undang-Undang.</p>
      <div class="flex space-x-4">
        <a href="/sitemap-index.xml" class="hover:text-brand-600">Sitemap XML</a>
        <a href="/robots.txt" class="hover:text-brand-600">Robots.txt</a>
