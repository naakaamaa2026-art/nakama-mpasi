---
---

<div class="bg-[#FAF8EE] rounded-3xl p-6 sm:p-10 border border-[#DFD8B4] shadow-xl max-w-4xl mx-auto my-8 transition-all">
  <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
    <span class="text-xs font-extrabold uppercase tracking-widest text-[#B7410E] bg-[#FAF0E6] px-4 py-1.5 rounded-full inline-block border border-[#B7410E]/30 shadow-sm">
      Kalkulator Nutrisi & Porsi MPASI
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-[#2D241E]">
      Hitung Kebutuhan & Tekstur <span class="pink-gradient-text">MPASI Si Kecil</span>
    </h2>
    <p class="text-xs sm:text-sm text-[#4E443C]">
      Masukkan usia dan berat badan anak mama untuk mendapatkan panduan porsi, jadwal, serta rekomendasi varian Nakama MPASI.
    </p>
  </div>

  <!-- Interactive Form Inputs -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 bg-[#F5F3E0] p-6 rounded-2xl border border-[#DFD8B4]">
    
    <!-- Usia Bayi Select -->
    <div class="space-y-2">
      <label class="block text-xs font-extrabold text-[#2D241E] uppercase tracking-wider">
        1. Usia Bayi
      </label>
      <select
        id="calc-age"
        class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#FAF8EE] text-[#2D241E] text-sm font-semibold focus:ring-2 focus:ring-[#B7410E] focus:outline-none"
      >
        <option value="6">6 Bulan (Awal MPASI)</option>
        <option value="7-8">7 - 8 Bulan</option>
        <option value="9-11">9 - 11 Bulan</option>
        <option value="12-24">12 - 24 Bulan</option>
      </select>
    </div>

    <!-- Berat Badan Input -->
    <div class="space-y-2">
      <label class="block text-xs font-extrabold text-[#2D241E] uppercase tracking-wider">
        2. Berat Badan (Kg)
      </label>
      <input
        type="number"
        id="calc-weight"
        min="4"
        max="18"
        step="0.1"
        value="7.5"
        class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#FAF8EE] text-[#2D241E] text-sm font-semibold focus:ring-2 focus:ring-[#B7410E] focus:outline-none"
      />
    </div>

    <!-- Kondisi / Status Makan -->
    <div class="space-y-2">
      <label class="block text-xs font-extrabold text-[#2D241E] uppercase tracking-wider">
        3. Kondisi Makan
      </label>
      <select
        id="calc-status"
        class="w-full px-4 py-3 rounded-xl border border-[#DFD8B4] bg-[#FAF8EE] text-[#2D241E] text-sm font-semibold focus:ring-2 focus:ring-[#B7410E] focus:outline-none"
      >
        <option value="normal">Lahap / Normal</option>
        <option value="gtm">GTM (Tutup Mulut)</option>
        <option value="weight-gain">Kejar Tumbuh / BB Seret</option>
      </select>
    </div>

  </div>

  <!-- Result Display Box -->
  <div id="calc-results" class="bg-[#FAF8EE] p-6 sm:p-8 rounded-2xl border-2 border-[#B7410E] space-y-6 shadow-md">
    
    <div class="flex items-center justify-between border-b border-[#DFD8B4] pb-4">
      <h3 class="text-lg font-extrabold text-[#B7410E] flex items-center gap-2">
        <span>📊</span> Hasil Rekomendasi Nutrisi MPASI
      </h3>
      <span id="res-badge" class="px-3.5 py-1 rounded-full text-xs font-extrabold text-white bg-[#B7410E] shadow-sm">
        Puree Halus
      </span>
    </div>

    <!-- Recommendations Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-center">
      
      <div class="p-4 rounded-xl bg-[#F5F3E0] shadow-sm border border-[#DFD8B4]">
        <div class="text-xs text-[#5A5046] font-bold mb-1">Tekstur Makanan</div>
        <div id="res-texture" class="text-sm font-extrabold text-[#2D241E]">Puree Halus (Lumat)</div>
      </div>

      <div class="p-4 rounded-xl bg-[#F5F3E0] shadow-sm border border-[#DFD8B4]">
        <div class="text-xs text-[#5A5046] font-bold mb-1">Frekuensi & Porsi</div>
        <div id="res-portion" class="text-sm font-extrabold text-[#2D241E]">2x Sehari (2-3 sdm)</div>
      </div>

      <div class="p-4 rounded-xl bg-[#F5F3E0] shadow-sm border border-[#DFD8B4]">
        <div class="text-xs text-[#5A5046] font-bold mb-1">Target AKG Zat Besi</div>
        <div id="res-iron" class="text-sm font-extrabold text-[#B7410E]">11 mg / hari</div>
      </div>

      <div class="p-4 rounded-xl bg-[#F5F3E0] shadow-sm border border-[#DFD8B4]">
        <div class="text-xs text-[#5A5046] font-bold mb-1">Kebutuhan Kalori MPASI</div>
        <div id="res-calories" class="text-sm font-extrabold text-[#B7410E]">~200 kkal / hari</div>
      </div>

    </div>

    <!-- Recommended Product Banner -->
    <div class="p-5 rounded-2xl bg-[#F5F3E0] border border-[#DFD8B4] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <span class="text-[11px] font-extrabold text-[#B7410E] uppercase tracking-wider">Rekomendasi Varian Nakama MPASI</span>
        <h4 id="res-product-name" class="text-base font-extrabold text-[#2D241E]">
          Nakama MPASI Varian Hati Ayam & Bayam
        </h4>
        <p id="res-product-desc" class="text-xs text-[#4E443C]">
          Formulasi tinggi zat besi dan asam folat alami untuk awal MPASI 6 bulan yang aman & mudah dicerna.
        </p>
      </div>

      <a
        id="res-wa-link"
        href="https://wa.me/6281234567890?text=Halo%20Nakama MPASI,%20saya%20mau%20pesan%20menu%20rekomendasi%20Kalkulator%20MPASI"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-full text-xs font-extrabold text-white bg-[#B7410E] hover:bg-[#96340B] shadow-md shadow-[#B7410E]/20 shrink-0 transition-all"
      >
        Pesan Varian Ini via WA &rarr;
      </a>
    </div>

  </div>
</div>

<script is:inline>
  const ageSelect = document.getElementById('calc-age');
  const weightInput = document.getElementById('calc-weight');
  const statusSelect = document.getElementById('calc-status');

  const resBadge = document.getElementById('res-badge');
  const resTexture = document.getElementById('res-texture');
  const resPortion = document.getElementById('res-portion');
  const resIron = document.getElementById('res-iron');
  const resCalories = document.getElementById('res-calories');
  const resProductName = document.getElementById('res-product-name');
  const resProductDesc = document.getElementById('res-product-desc');
  const resWaLink = document.getElementById('res-wa-link');

  function calculateMPASI() {
    const age = ageSelect?.value || '6';
    const weight = parseFloat(weightInput?.value || '7.5');
    const status = statusSelect?.value || 'normal';

    let texture = '';
    let portion = '';
    let iron = '11 mg / hari';
    let calories = '';
    let prodName = '';
    let prodDesc = '';

    if (age === '6') {
      texture = 'Puree Halus (Lumat)';
      portion = status === 'gtm' ? '2-3x Sehari (1-2 sdm bertahap)' : '2-3x Sehari (2-3 sdm)';
      calories = '~200 kkal / hari';
      prodName = 'Nakama MPASI Varian Hati Ayam & Bayam';
      prodDesc = 'Sangat kaya zat besi alami dari hati ayam & asam folat bayam Jepang. Tekstur halus mudah dicerna bayi 6 bulan.';
    } else if (age === '7-8') {
      texture = 'Saring / Semi Halus';
      portion = status === 'weight-gain' ? '3x Makan + 2x Selingan (3-4 sdm)' : '2-3x Makan Utama (2-4 sdm)';
      calories = '~250-300 kkal / hari';
      prodName = 'Nakama MPASI Varian Hati Ayam & Daging Sapi';
      prodDesc = 'Double protein hewani untuk mengoptimalkan kenaikan berat badan dan stimulasi motorik oromotor.';
    } else if (age === '9-11') {
      texture = 'Cincang Halus / Chopped';
      portion = '3x Makan + 1-2x Selingan (1/2 mangkuk kecil)';
      calories = '~300-400 kkal / hari';
      prodName = 'Nakama MPASI Daging Sapi & Butter';
      prodDesc = 'Tekstur cincang lembut dengan aromatik unsalted butter yang membangkitkan selera makan bayi saat tumbuh gigi.';
    } else {
      texture = 'Nasi Tim Lembek / Makanan Keluarga';
      portion = '3x Makan Utama + 2x Selingan (3/4 - 1 mangkuk)';
      calories = '~550-600 kkal / hari';
      prodName = 'Nakama MPASI Salmon & Ubi Manis';
      prodDesc = 'Kaya Omega-3 & DHA untuk perkembangan otak emas si kecil usia 1-2 tahun.';
    }

    if (resBadge) resBadge.textContent = texture;
    if (resTexture) resTexture.textContent = texture;
    if (resPortion) resPortion.textContent = portion;
    if (resIron) resIron.textContent = iron;
    if (resCalories) resCalories.textContent = calories;
    if (resProductName) resProductName.textContent = prodName;
    if (resProductDesc) resProductDesc.textContent = prodDesc;
    if (resWaLink) {
      resWaLink.href = `https://wa.me/6281234567890?text=Halo%20Nakama MPASI,%20saya%20mau%20pesan%20${encodeURIComponent(prodName)}%20(Usia%20${age}%20Bulan,%20BB%20${weight}kg)`;
    }
  }

  ageSelect?.addEventListener('change', calculateMPASI);
  weightInput?.addEventListener('input', calculateMPASI);
  statusSelect?.addEventListener('change', calculateMPASI);

  // Initial Calculation
  calculateMPASI();
</script>
